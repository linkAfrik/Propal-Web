# COPHIR site: Apache settings (Infomaniak)

# One address only: https://www.cophir.com (301 from cophir.com and from http)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^cophir\.com$ [NC]
RewriteRule ^ https://www.cophir.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean addresses without ".html": /about serves about.html, old .html links redirect (301)
Options -MultiViews
RewriteCond %{THE_REQUEST} \s/+((?:fr/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+((?:fr/)?[a-z-]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Correct types for the film and its subtitles
AddType video/mp4 .mp4
AddType text/vtt .vtt
AddDefaultCharset UTF-8

# Keep sources and tooling private if they ever reach the server
RedirectMatch 404 /(src|\.git|\.github)(/|$)
RedirectMatch 404 /(build\.py|README\.md)$

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/vtt image/svg+xml application/json
</IfModule>

# Browser cache: long for media, short for pages
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
